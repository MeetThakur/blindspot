# Copy to server/.env for local development (loaded by `npm run dev`).
# In production, set these in your host's dashboard instead; .env files are not deployed.

# Port to listen on. Most hosts inject PORT for you.
PORT=3001

# Origin(s) of the deployed frontend, comma separated, no trailing slash.
# REQUIRED when NODE_ENV=production. Only these origins may open a WebSocket or call /health from a browser.
CLIENT_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of the server (Render, Railway, Fly: 1; behind Cloudflare too: 2).
# 0 = use the socket address. Wrong values let clients spoof their IP and dodge the rate limits.
TRUST_PROXY_HOPS=0

# Abuse limits (defaults shown).
MAX_ROOMS_PER_IP=3
MAX_ROOMS=2000
CREATE_ROOM_LIMIT=5
JOIN_LIMIT_PER_MIN=30
